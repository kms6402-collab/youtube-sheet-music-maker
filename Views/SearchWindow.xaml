<Window x:Class="ScoreCap.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ScoreCap.Converters"
        Title="유튜브 영상 검색" Height="560" Width="620" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <conv:EqualityToBooleanConverter x:Key="EqConv"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryTextBox" Grid.Column="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="QueryTextBox_OnKeyDown" ToolTip="검색어 (일반 텍스트 / 정규식 / 와일드카드)"/>
            <Button Grid.Column="2" Content="검색" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7"
                    Command="{Binding SearchCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="대상" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource LabelStyle}"/>
            <RadioButton Content="제목" GroupName="Target" Margin="0,0,4,0" Style="{StaticResource ChipRadioButtonStyle}"
                         IsChecked="{Binding Target, Converter={StaticResource EqConv}, ConverterParameter=Title}"/>
            <RadioButton Content="작성자" GroupName="Target" Margin="4,0,20,0" Style="{StaticResource ChipRadioButtonStyle}"
                         IsChecked="{Binding Target, Converter={StaticResource EqConv}, ConverterParameter=Uploader}"/>

            <TextBlock Text="방식" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource LabelStyle}"/>
            <RadioButton Content="일반" GroupName="Mode" Margin="0,0,4,0" Style="{StaticResource ChipRadioButtonStyle}"
                         IsChecked="{Binding Mode, Converter={StaticResource EqConv}, ConverterParameter=Plain}"/>
            <RadioButton Content="정규식" GroupName="Mode" Margin="4,0,4,0" Style="{StaticResource ChipRadioButtonStyle}"
                         IsChecked="{Binding Mode, Converter={StaticResource EqConv}, ConverterParameter=Regex}"/>
            <RadioButton Content="와일드카드" GroupName="Mode" Margin="4,0,0,0" Style="{StaticResource ChipRadioButtonStyle}"
                         IsChecked="{Binding Mode, Converter={StaticResource EqConv}, ConverterParameter=Wildcard}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4">
            <ListBox x:Name="ResultsListBox" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                     BorderThickness="0" Background="Transparent" MouseDoubleClick="ResultsListBox_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8" Margin="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="120" Height="68" Background="{StaticResource SubtleBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                        <Run Text="{Binding Uploader, Mode=OneWay}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding DurationLabel, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" Margin="0,0,8,0" Click="CancelButton_OnClick"/>
            <Button Content="선택" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" Click="ChooseButton_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
